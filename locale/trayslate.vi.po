msgstr "Tự động thêm khi thay đổi cặp"

#: tformsettingstrayslate.checkautoaddlangpairs.hint
msgid "Automatically adds a new language pair when you switch languages"
msgstr "Tự động thêm cặp ngôn ngữ mới khi bạn chuyển đổi ngôn ngữ"

#: tformsettingstrayslate.checkautocopy.caption
msgctxt "tformsettingstrayslate.checkautocopy.caption"
msgid "Auto-Copy Translation"
msgstr "Tự động sao chép bản dịch"

#: tformsettingstrayslate.checkautocopy.hint
msgid "Automatically copy translations from the main and popup windows to the clipboard"
msgstr "Tự động sao chép bản dịch từ cửa sổ chính và cửa sổ bật lên vào khay nhớ tạm"

#: tformsettingstrayslate.checkautoheight.caption
msgid "Auto Height"
msgstr "Chiều cao tự động"

#: tformsettingstrayslate.checkautoheight.hint
msgid "Popup window height calculated based on text height"
msgstr "Chiều cao cửa sổ bật lên được tính dựa trên chiều cao văn bản"

#: tformsettingstrayslate.checkautostart.caption
msgid "Launch At System Startup"
msgstr "Khởi động cùng hệ thống"

#: tformsettingstrayslate.checkautostart.hint
msgid "Start the application automatically when the computer boots"
msgstr "Tự động khởi động ứng dụng khi máy tính khởi động"

#: tformsettingstrayslate.checkautoswap.caption
msgctxt "tformsettingstrayslate.checkautoswap.caption"
msgid "Auto-Swap Language Pair"
msgstr "Tự động hoán đổi cặp ngôn ngữ"

#: tformsettingstrayslate.checkautoswap.hint
msgid "Automatically detect input language and swap pair if needed, does not work during Real-Time Translation"
msgstr "Tự động phát hiện ngôn ngữ đầu vào và cặp hoán đổi nếu cần, không hoạt động trong quá trình dịch thời gian thực"

#: tformsettingstrayslate.checkbuiltindetect.caption
msgid "Use Built-In Language Detection Engine"
msgstr "Sử dụng Công cụ phát hiện ngôn ngữ tích hợp"

#: tformsettingstrayslate.checkbuiltindetect.hint
msgid "Uses the built-in language detection engine instead of the translation service configuration. This is faster, but supports only a limited number of languages."
msgstr "Sử dụng công cụ phát hiện ngôn ngữ tích hợp thay vì cấu hình dịch vụ dịch thuật. Điều này nhanh hơn nhưng chỉ hỗ trợ một số ngôn ngữ hạn chế."

#: tformsettingstrayslate.checkcircularicon.caption
msgid "Circular Icon"
msgstr "Biểu tượng hình tròn"

#: tformsettingstrayslate.checkcircularicon.hint
msgctxt "tformsettingstrayslate.checkcircularicon.hint"
msgid "Icon displayed in a circular shape"
msgstr "Biểu tượng được hiển thị theo hình tròn"

#: tformsettingstrayslate.checkenablemousemode.caption
msgctxt "tformsettingstrayslate.checkenablemousemode.caption"
msgid "Enable Mouse Mode"
msgstr "Bật chế độ chuột"

#: tformsettingstrayslate.checkenablemousemode.hint
msgid "Allows translation by selecting text with the mouse in any application"
msgstr "Cho phép dịch bằng cách chọn văn bản bằng chuột trong bất kỳ ứng dụng nào"

#: tformsettingstrayslate.checkhidecontrols.caption
msgid "Auto-Hide Controls"
msgstr "Tự động ẩn điều khiển"

#: tformsettingstrayslate.checkhidecontrols.hint
msgid "Hide window controls when the mouse is not over the popup window"
msgstr "Ẩn điều khiển cửa sổ khi chuột không ở trên cửa sổ bật lên"

#: tformsettingstrayslate.checkinsertkey.caption
msgid "Use Insert for Copy and Paste Emulation"
msgstr "Sử dụng mô phỏng phím Insert để sao chép và dán"

#: tformsettingstrayslate.checkinsertkey.hint
msgid "Use Ctrl+Insert and Shift+Insert key emulation for copying and pasting text from applications; otherwise, use Ctrl+C and Ctrl+V."
msgstr "Sử dụng mô phỏng các phím Ctrl+Insert và Shift+Insert để sao chép và dán văn bản từ các ứng dụng; nếu không, sử dụng Ctrl+C và Ctrl+V."

#: tformsettingstrayslate.checkmousemodectrl.caption
msgctxt "tformsettingstrayslate.checkmousemodectrl.caption"
msgid "Only When Ctrl Is Pressed"
msgstr "Chỉ khi nhấn Ctrl"

#: tformsettingstrayslate.checkmousemodectrl.hint
msgid "Works only when the Ctrl key is pressed"
msgstr "Chỉ hoạt động khi nhấn phím Ctrl"

#: tformsettingstrayslate.checkproxyauthentication.caption
msgctxt "tformsettingstrayslate.checkproxyauthentication.caption"
msgid "Authentication"
msgstr "Xác thực"

#: tformsettingstrayslate.checkproxyauthentication.hint
msgid "Enables login and password authentication for proxy access"
msgstr "Cho phép xác thực đăng nhập và mật khẩu để truy cập proxy"

#: tformsettingstrayslate.checkrealtime.caption
msgctxt "tformsettingstrayslate.checkrealtime.caption"
msgid "Translate As You Type"
msgstr "Dịch khi bạn gõ"

#: tformsettingstrayslate.checkrealtime.hint
msgctxt "tformsettingstrayslate.checkrealtime.hint"
msgid "Automatically translate text while typing"
msgstr "Tự động dịch văn bản khi gõ"

#: tformsettingstrayslate.checksmarthard.caption
msgid "Always Prefer Primary/Secondary Language"
msgstr "Luôn Ưu Tiên Ngôn Ngữ Chính/Phụ"

#: tformsettingstrayslate.checksmarthard.hint
msgid ""
"Always prefer the Primary/Secondary language pair when the detected language matches the current target language.\n"
"Restore the configured pair instead of performing a normal swap."
msgstr ""
"Luôn ưu tiên cặp ngôn ngữ Chính/Phụ khi ngôn ngữ được phát hiện khớp với ngôn ngữ đích hiện tại.\n"
"Khôi phục cặp đã định cấu hình thay vì thực hiện hoán đổi thông thường."

#: tformsettingstrayslate.checksmartswap.caption
msgctxt "tformsettingstrayslate.checksmartswap.caption"
msgid "Smart Swap For Languages Outside Pair"
msgstr "Hoán đổi thông minh cho các ngôn ngữ bên ngoài cặp"

#: tformsettingstrayslate.checksmartswap.hint
msgctxt "tformsettingstrayslate.checksmartswap.hint"
msgid ""
"If Detected language is outside the current pair, the Source language is replaced with the Detected language and the Target language is set to Primary.\n"
"If Detected language equals Primary, the translation pair is set to Primary - Secondary."
msgstr ""
"Nếu ngôn ngữ được phát hiện nằm ngoài cặp hiện tại, ngôn ngữ Nguồn được thay thế bằng ngôn ngữ được phát hiện và ngôn ngữ đích được đặt thành Chính.\n"
"Nếu ngôn ngữ được phát hiện bằng Chính, cặp dịch được đặt thành Chính - Phụ."

#: tformsettingstrayslate.checkspellcheck.caption
msgctxt "tformsettingstrayslate.checkspellcheck.caption"
msgid "Enable Spell Check"
msgstr "Bật kiểm tra chính tả"

#: tformsettingstrayslate.checkspellcheck.hint
msgctxt "tformsettingstrayslate.checkspellcheck.hint"
msgid "Enable spell checking in the source text"
msgstr "Bật kiểm tra chính tả trong văn bản nguồn"

#: tformsettingstrayslate.checkspellcheckemptysuggestions.caption
msgid "Underline errors without suggestions"
msgstr "Gạch chân lỗi không có đề xuất"

#: tformsettingstrayslate.checkspellcheckemptysuggestions.hint
msgid "Underline errors for which no corrections have been suggested"
msgstr "Gạch chân các lỗi chưa có đề xuất sửa lỗi"

#: tformsettingstrayslate.checkstayontop.caption
msgid "Stay On Top"
msgstr "Luôn trên cùng"

#: tformsettingstrayslate.checkstayontop.hint
msgid "Keeps the window above all other windows"
msgstr "Giữ cửa sổ ở trên tất cả các cửa sổ khác"

#: tformsettingstrayslate.checktwolang.caption
msgid "Show Language Pair"
msgstr "Hiển thị cặp ngôn ngữ"

#: tformsettingstrayslate.checktwolang.hint
msgctxt "tformsettingstrayslate.checktwolang.hint"
msgid "Display source and/or target language on the tray icon"
msgstr "Hiển thị ngôn ngữ nguồn và/hoặc ngôn ngữ đích trên biểu tượng khay"

#: tformsettingstrayslate.checkverticalsplit.caption
msgctxt "tformsettingstrayslate.checkverticalsplit.caption"
msgid "Side-By-Side Layout"
msgstr "Bố cục cạnh nhau"

#: tformsettingstrayslate.checkverticalsplit.hint
msgid "Switches to side-by-side layout with source text beside translation"
msgstr "Chuyển sang bố cục cạnh nhau với văn bản nguồn bên cạnh bản dịch"

#: tformsettingstrayslate.coloriconbackground.hint
msgid "Background color of the tray icon"
msgstr "Màu nền của biểu tượng khay hệ thống"

#: tformsettingstrayslate.coloriconfont.hint
msgid "Font color of the tray icon"
msgstr "Màu phông chữ của biểu tượng khay hệ thống"

